# ==========================================
# DBL Campus — Internet HTTPS Deployment Configuration
# ==========================================

# Application environment ("production" for public internet hosting)
NODE_ENV=production
PORT=3000

# Public HTTPS URL where DBL Campus is hosted (used for CORS allowlist & links)
APP_URL="https://campus.example.edu"

# Optional comma-separated list of additional trusted HTTPS origins
ALLOWED_ORIGINS=

# Reverse proxy hop count (1 behind Caddy/Nginx/Render/Fly/Cloudflare, "false" when direct)
TRUST_PROXY=1

# Redirect plain HTTP to HTTPS automatically when behind a TLS proxy in production
DBL_FORCE_HTTPS=true

# Persistent storage root directory (mount your Docker Volume / VPS Disk / Fly Volume here)
DBL_DATA_DIR=./data

# Optional granular path overrides (default to subdirectories inside DBL_DATA_DIR)
DBL_DB_PATH=
DBL_UPLOADS_DIR=
DBL_RELEASES_DIR=

# Public internet safety: keep false in production so demo accounts cannot be accessed publicly
DBL_ALLOW_DEMO=false

# Required secret passcode to claim the first-run Production Representative account
DBL_ADMIN_SETUP_CODE=

# Optional domain name for Caddy automatic HTTPS in docker-compose.yml
DOMAIN=campus.example.edu
