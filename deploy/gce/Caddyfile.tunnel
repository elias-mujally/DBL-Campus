{
	auto_https off
}

:8080 {
	request_body {
		max_size 100MB
	}
	# The local connector forwards the scheme set by Cloudflare's edge.
	@edgePlain header X-Forwarded-Proto http
	redir @edgePlain https://{$DOMAIN}{uri} 308
	header /api/* {
		Cache-Control "private, no-store"
		defer
	}
	# Only the host-local tunnel connector can send requests to this listener.
	@cloudflare header CF-Connecting-IP *
	handle @cloudflare {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
